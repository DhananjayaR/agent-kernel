{
	"name": "ak-studio",
	"version": "0.0.0",
	"private": true,
	"description": "Open Agent Kernel Studio (OAK Studio) workspace",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": "24.22.1"
	},
	"scripts": {
		"dev": "pnpm --filter @ak-studio/desktop dev",
		"build": "pnpm check-palette && pnpm compile-schemas:check && pnpm --filter @ak-studio/desktop build",
		"test": "pnpm -r --if-present test && pnpm check-palette:test && pnpm compile-schemas:test",
		"lint": "biome check --error-on-warnings . && pnpm check-palette && pnpm compile-schemas:check && pnpm depcruise && pnpm depcruise:selftest",
		"typecheck": "tsc -b",
		"storybook": "pnpm --filter @ak-studio/ui storybook",
		"build-storybook": "pnpm --filter @ak-studio/ui build-storybook",
		"test:storybook": "pnpm --filter @ak-studio/ui test:storybook",
		"build:e2e": "pnpm check-palette && pnpm compile-schemas:check && pnpm --filter @ak-studio/desktop build:e2e",
		"test:e2e": "pnpm build:e2e && node tools/e2e.mjs",
		"package": "pnpm build && pnpm --filter @ak-studio/desktop package",
		"test:packaged": "node tools/packaged-smoke.mjs",
		"depcruise": "node tools/depcruise.mjs",
		"depcruise:selftest": "node tools/depcruise-selftest/run.mjs",
		"check-palette": "node tools/check-palette.mjs",
		"check-palette:test": "vitest run tools/check-palette.test.mjs",
		"compile-schemas": "node tools/compile-schemas.mjs",
		"compile-schemas:check": "node tools/compile-schemas.mjs --check",
		"compile-schemas:test": "vitest run tools/compile-schemas.test.mjs",
		"make-app-icon": "node tools/make-app-icon.mjs",
		"third-party-notices": "node tools/third-party-notices.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "1.65.1",
		"@swc/core": "1.16.22",
		"@types/node": "24.19.2",
		"ajv": "8.20.0",
		"dependency-cruiser": "18.9.0",
		"typescript": "7.0.2",
		"vitest": "5.1.1"
	}
}

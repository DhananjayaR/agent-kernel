{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/tools/depcruise-selftest/fixture",
			"!**/packages/ui/src/assets/oak-mark-*.svg"
		]
	},
	"formatter": { "enabled": true, "indentStyle": "tab", "lineEnding": "lf" },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"lucide-react": "Interface icons are Tabler outline icons: import them from @tabler/icons-react (branding/README.md)."
						}
					}
				}
			}
		}
	},
	"javascript": { "formatter": { "quoteStyle": "double" } },
	"css": { "parser": { "tailwindDirectives": true } },
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "on" } }
	}
}
